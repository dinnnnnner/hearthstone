{
  "name": "bobs-tavern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "tsx --test src/engine.test.ts src/season/engine.test.ts src/scouting.test.ts src/table/presentation.test.ts",
    "test:e2e": "playwright test",
    "build:site": "TAVERN_BASE=/tavern/ npm run build && python3 scripts/package-site.py",
    "build:server": "node scripts/build-server.mjs",
    "dev:server": "tsx server/index.ts",
    "build:rl": "node scripts/build-rl.mjs",
    "test:rl": "tsc -p rl/tsconfig.json && tsx --test rl/environment.test.ts",
    "package:rl": "npm run build:rl && python3 scripts/package-rl.py",
    "test:server": "npm run build:server && tsx --test server/rooms.test.ts server/http.test.ts server/persistence.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "esbuild": "^0.28.2"
  }
}
