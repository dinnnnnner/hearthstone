  "concurrent_benchmark_sources": {
    "run-concurrent.py": "import json,os,signal,subprocess,sys,time\nfrom pathlib import Path\nw=Path(__file__).resolve().parent\nresults=[]\n# The complete-game comparison owns the GPU first.\nwhile Path('/proc/31767').exists():\n time.sleep(2)\nfull=json.loads((w/'full-games.json').read_text())\nassert len(full['rows'])==2 and all(r['replay_actions_equal'] and r['complete_games']==4 and r['truncated_games']==0 for r in full['rows'])\nstatus=json.loads(Path('/root/tavern-four-hour-20260914/population/status.json').read_text())\nassert status['stage']=='interrupted' and all(m['pid'] is None for m in status['members'])\nfor index,mode in enumerate(['eager','graph','eager']):\n workers=16\n os.environ['TAVERN_SAMPLING_GRAPHS']='1' if mode=='graph' else '0'\n case=w/f'case-{index}-{mode}';case.mkdir()\n processes=[];logs=[];started=time.monotonic();last=0;go=False;resource=[]\n try:\n  for member in range(3):\n   log=(case/f'member-{member}.log').open('w');logs.append(log)\n   processes.append(subprocess.Popen([sys.executable,'-u',str(w/'worker.py'),'--member',str(member),'--workers',str(workers),'--case',str(case)],stdout=log,stderr=subprocess.STDOUT,start_new_session=True))\n  while any(p.poll() is None for p in processes):\n   if any(p.poll() not in (None,0) for p in processes):raise RuntimeError('Benchmark worker failed; see member logs')\n   if time.monotonic()-started>900:raise TimeoutError('Benchmark case timeout')\n   if not go and len(list(case.glob('ready-*')))==3:\n    (case/'go').write_text('go');go=True\n   if time.monotonic()-last>30:\n    last=time.monotonic();gpu=subprocess.check_output(['nvidia-smi','--query-gpu=utilization.gpu,memory.used','--format=csv,noheader,nounits'],text=True).strip()\n    resource.append(dict(seconds=time.monotonic()-started,gpu=gpu))\n    print(json.dumps(dict(case=index,workers=workers,stage='sampling' if go else 'warmup',seconds=round(time.monotonic()-started),finished=sum(p.poll() is not None for p in processes),gpu=gpu)),flush=True)\n   time.sleep(1)\n  assert all(p.returncode==0 for p in processes)\n  rows=[json.loads((case/f'result-{i}.json').read_text()) for i in range(3)]\n  r=dict(mode=mode,workers=workers,rows=rows,resource=resource);results.append(r)\n  (w/'results.json').write_text(json.dumps(results,indent=2)+'\\n')\n finally:\n  for p in processes:\n   if p.poll() is None:\n    try:os.killpg(p.pid,signal.SIGTERM)\n    except ProcessLookupError:pass\n  for p in processes:\n   try:p.wait(timeout=10)\n   except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait()\n  for log in logs:log.close()\nassert all(case['rows'][i]['tapes']==results[0]['rows'][i]['tapes'] for case in results for i in range(3))\nprint('COMPLETED: all replay actions agree',flush=True)\n",
    "worker.py": "import argparse,gc,hashlib,json,time,tempfile\nfrom pathlib import Path\nimport torch\nfrom tavern_rl.bridge import Simulator\nfrom tavern_rl.rollout import SimulationPool\nfrom tavern_rl.train import load_checkpoint,frozen_models,league_weights\np=argparse.ArgumentParser();p.add_argument('--member',type=int);p.add_argument('--workers',type=int);p.add_argument('--case',type=Path);p.add_argument('--steps',type=int,default=256);a=p.parse_args()\ntorch.set_num_threads(1)\ncheckpoint=Path(f'/root/tavern-four-hour-20260914/population/member-{a.member}/training/latest.pt')\nsource_hash=hashlib.file_digest(checkpoint.open('rb'),'sha256').hexdigest()\nwith Simulator() as sim:meta=sim.meta\nsaved,model=load_checkpoint(checkpoint,meta,'cuda');opponents=frozen_models(saved['league'],model.specification(),'cuda');probabilities=league_weights(saved['league']);config=saved['config'];del saved;gc.collect()\nkwargs=dict(learner_seats=config['learner_seats'],opponent_weights=probabilities,unused_gold_penalty=config['unused_gold_penalty'],first_place_bonus=config['first_place_bonus'],hero_pool=config.get('hero_pool'),packed_host_transfer=False)\npool=SimulationPool(a.workers)\ntry:\n pool.collect(model,opponents,range(810000,810000+a.workers),dict(config['options'],maxSteps=4,recordFrames=False),'cuda',**kwargs)\n torch.cuda.synchronize();torch.cuda.reset_peak_memory_stats()\n (a.case/f'ready-{a.member}').write_text('ready')\n deadline=time.monotonic()+600\n while not (a.case/'go').exists():\n  if time.monotonic()>deadline:raise TimeoutError('Peer warmup timeout')\n  time.sleep(.1)\n with tempfile.TemporaryDirectory(prefix='rollout-concurrency-') as directory:\n  def progress(row):print(json.dumps(dict(member=a.member,workers=a.workers,**row)),flush=True)\n  tracks,games,perf=pool.collect(model,opponents,range(820000,820016),dict(config['options'],maxSteps=a.steps,recordFrames=False),'cuda',**kwargs,replay_dir=directory,progress=progress)\n  tapes={p.name:hashlib.sha256(json.dumps(json.loads(p.read_text())['actions'],sort_keys=True).encode()).hexdigest() for p in Path(directory).glob('game-*.json')}\n  assert len(tapes)==16\n  assert all(g['terminated'] or g['truncated'] for g in games)\n  row=dict(member=a.member,depth=model.specification()['policy_depth'],workers=a.workers,steps=a.steps,checkpointSha256=source_hash,**perf,cudaPeakMiB=torch.cuda.max_memory_allocated()/2**20,tapes=tapes,completed=sum(g['terminated'] for g in games),truncated=sum(g['truncated'] for g in games))\n  (a.case/f'result-{a.member}.json').write_text(json.dumps(row,indent=2)+'\\n')\n  print(json.dumps({k:v for k,v in row.items() if k!='tapes'}),flush=True)\n assert hashlib.file_digest(checkpoint.open('rb'),'sha256').hexdigest()==source_hash\nfinally:pool.close()\n"
