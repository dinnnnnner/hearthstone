[Unit]
Description=Forward public 256-layer and 1024-layer inference to this computer
Wants=tavern-model@deep256.service tavern-model@deep1024.service
After=tavern-model@deep256.service tavern-model@deep1024.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 127.0.0.1:18793:127.0.0.1:18792 -R 127.0.0.1:18795:127.0.0.1:18794 root@100.121.69.44
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
