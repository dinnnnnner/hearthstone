[Unit]
Description=Battlegrounds trained policy CPU inference
After=network.target

[Service]
Type=simple
User=bobs-tavern
Group=bobs-tavern
WorkingDirectory=/opt/tavern-inference/current
Environment=PYTHONPATH=/opt/tavern-inference/current/python
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/opt/tavern-inference-venv/bin/python -m tavern_rl.serve model.pt --port 8790
Restart=on-failure
RestartSec=3
MemoryMax=512M
CPUQuota=80%
TasksMax=16
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
