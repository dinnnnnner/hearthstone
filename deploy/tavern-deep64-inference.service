[Unit]
Description=Local 64-layer Battlegrounds inference

[Service]
Type=simple
WorkingDirectory=%h/.local/share/tavern-deep64/current
Environment=PYTHONPATH=%h/.local/share/tavern-deep64/current/python
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=%h/hearthstone/.venv/bin/python -m tavern_rl.serve model.pt --port 18790
Restart=on-failure
RestartSec=3
MemoryMax=1G
CPUQuota=100%
TasksMax=32
NoNewPrivileges=true

[Install]
WantedBy=default.target
